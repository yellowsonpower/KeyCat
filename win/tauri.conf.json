    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERjI2OTA3Q0I4N0Q5RTQKUldUazJZZkxCMm55dlVUSHBheUI1ZHF3d3BnMmF0dnlWRmhZbERxdDdvRUVzU1VqUnArTVMvUnQK",
      "endpoints": ["https://github.com/yellowsonpower/KeyCat/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
