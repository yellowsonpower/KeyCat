{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyCat",
  "mainBinaryName": "KeyCat",
  "version": "./package.json",
  "identifier": "com.ellobok.keycat",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "copyright": "Copyright © ElloboDK",
